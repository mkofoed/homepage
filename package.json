{
  "name": "homepage",
  "version": "1.0.0",
  "description": "Tailwind CSS build pipeline for the mkofoed.dev homepage",
  "private": true,
  "license": "MIT",
  "author": "Mikkel Kofoed",
  "keywords": [
    "tailwindcss",
    "django",
    "homepage"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind/tailwind.src.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind/tailwind.src.css -o ./static/css/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkofoed/homepage.git"
  },
  "bugs": {
    "url": "https://github.com/mkofoed/homepage/issues"
  },
  "homepage": "https://github.com/mkofoed/homepage#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2"
  }
}
